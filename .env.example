# Copy to .env.local and fill in. `npm run db:setup` reads DATABASE_URL.
DATABASE_URL=postgres://clandar:clandar_dev@localhost:5432/clandar_expense

# Backs the BullMQ job queue (Gmail cleanup analysis). Run:
#   docker run -d --name clandar-redis -p 6379:6379 --restart unless-stopped redis:7-alpine
REDIS_URL=redis://localhost:6379

# AES-256-GCM key for connector secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Google OAuth client for the Gmail and Calendar connectors. Leave empty to
# keep those connectors greyed out on /connectors.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Leave unset: the redirect URI is derived from whichever address you connect
# from (localhost, a LAN IP, Tailscale, …), shown live on /connectors. Set this
# only to pin one fixed URL, e.g. for a production deployment behind a stable
# domain — every address used must be registered on the OAuth client either way.
GOOGLE_REDIRECT_URI=

# Signs the sign-in session cookie (lib/auth.ts). Also uses the Google client
# above, but only for "Continue with Google" login itself — a separate concern
# from the Gmail/Calendar connectors' own OAuth. Falls back to
# APP_ENCRYPTION_KEY if left blank. Generate one the same way:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Comma-separated Google account emails that get platform-admin access at
# /admin — cross-tenant, not tied to any one org's "owner" role. Leave empty
# and /admin is unreachable by anyone. See lib/admin.ts.
ADMIN_EMAILS=

# Cloudflare R2 (S3-compatible) storage for project photos/files and chat
# attachments (lib/storage.ts). Leave all of these empty to store on local
# disk under UPLOADS_DIR instead — useful for local dev, but doesn't survive
# a redeploy on most hosts, so set these for anything beyond your own machine.
# R2_ACCOUNT_ID is only used to derive the default endpoint
# (https://<account_id>.r2.cloudflarestorage.com); set R2_ENDPOINT directly
# instead if you're using a custom domain or jurisdiction-specific endpoint.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Browser push notifications for due reminders (lib/push.ts). Generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave empty to turn push off (email and the in-app bell still work).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects /api/cron/reminders. Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
# automatically when this is set; an external pinger must send the same header.
CRON_SECRET=
